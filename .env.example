# =============================================================================
# JalDrishti Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values.
#
# FOR LOCAL DEVELOPMENT (Option B in README): use these defaults as-is.
# FOR DOCKER COMPOSE (Option A in README): also copy .env.docker -> .env
#   or manually change *_HOST values to the Docker service names below.

# --- Application ---
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-to-a-random-secret

# --- Database (PostgreSQL) ---
# Local dev: localhost | Docker Compose: db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=jaldrishti
POSTGRES_USER=jaldrishti_user
POSTGRES_PASSWORD=change-me

# --- Redis ---
# Local dev: localhost | Docker Compose: redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# --- Celery ---
# Local dev: redis://localhost:6379/0 | Docker: redis://redis:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- API Keys (Tier 2 - Advisory Layer) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Logging ---
LOG_LEVEL=INFO
